# mock = in-memory API, no backend needed. live = talk to fix60_backend.
EXPO_PUBLIC_API_MODE=mock
# API origin (no /api/v1). Android emulator reaches the host at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# dev = OTP 123456 + dev:<phone> tokens (backend AUTH_ALLOW_DEV_TOKENS=true). firebase = real phone OTP.
EXPO_PUBLIC_AUTH_MODE=dev
