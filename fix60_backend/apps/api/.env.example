NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Local dev DB from docker-compose.dev.yml (port 5446)
DATABASE_URL=postgres://fix60:fix60@127.0.0.1:5446/fix60
# Public site + admin panel origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# true behind a load balancer / reverse proxy
TRUST_PROXY=false

# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_TOKEN_TTL_HOURS=12
# openssl rand -base64 32  (encrypts admin TOTP secrets; rotating it forces TOTP re-enrolment)
ADMIN_TOTP_ENCRYPTION_KEY=
# Must stay true outside local development
ADMIN_TOTP_REQUIRED=true

# Firebase project that issues phone-auth ID tokens
FIREBASE_PROJECT_ID=
# base64 of the service-account JSON (needed for FCM pushes and App Check)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_APP_CHECK_ENFORCED=false
# Dev only: accept "dev:+919876543210" as an idToken. Rejected when NODE_ENV=production.
AUTH_ALLOW_DEV_TOKENS=true

# local | s3 (AWS S3, Cloudflare R2, MinIO). The bucket must block all public access.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# fcm | log
PUSH_PROVIDER=log

# Seed only (pnpm db:seed): first Super Admin. Remove after first run.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
